# ===== 数据库 =====
DB_DSN=root:your_password@tcp(127.0.0.1:3306)/community?charset=utf8mb4&parseTime=True

# ===== JWT =====
JWT_SECRET=your-secret-key-change-in-production

# ===== 服务端口 =====
PORT=8080

# ===== root 初始密码（仅首次部署需要）=====
# 二选一：直接设置密码，或指定包含密码的文件路径（适用于 Docker secrets / K8s secrets）
ROOT_PASSWORD=
# ROOT_PASSWORD_FILE=/run/secrets/root_password

# ===== TLS / HTTPS（可选，不设则走 HTTP）=====
# TLS_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem

# ===== 文件上传 =====
UPLOAD_IMG_DIR=../uploads/images
UPLOAD_FILE_DIR=../uploads/files
SERVE_IMG_PREFIX=/uploads/images
SERVE_FILE_PREFIX=/uploads/files
